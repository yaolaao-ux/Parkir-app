<Application x:Class="Parkir.Pos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172321" />
        <SolidColorBrush x:Key="Muted" Color="#687773" />
        <SolidColorBrush x:Key="Canvas" Color="#F3F5F1" />
        <SolidColorBrush x:Key="Accent" Color="#137B67" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Application.Resources>
</Application>